{
  "name": "multitenant-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant microservice backend (NestJS, PostgreSQL schema-per-tenant, Redis events)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs,test}/**/*.ts\"",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "db:migrate": "ts-node -r tsconfig-paths/register apps/tenant-service/src/migration-run.ts",
    "db:revert": "ts-node -r tsconfig-paths/register apps/tenant-service/src/migration-revert.ts",
    "dev": "node scripts/dev.mjs",
    "dev:gateway": "ts-node -r tsconfig-paths/register apps/gateway/src/main.ts",
    "dev:tenant": "ts-node -r tsconfig-paths/register apps/tenant-service/src/main.ts",
    "dev:user": "ts-node -r tsconfig-paths/register apps/user-service/src/main.ts",
    "start:gateway": "node -r ./register-paths.js dist/apps/gateway/main.js",
    "start:tenant": "node -r ./register-paths.js dist/apps/tenant-service/main.js",
    "start:user": "node -r ./register-paths.js dist/apps/user-service/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}